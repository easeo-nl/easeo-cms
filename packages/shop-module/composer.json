{
    "name": "easeo/shop-module",
    "description": "EASEO CMS — Shop module skeleton with Payment-provider abstraction. Skelet only; eurolight-webshop logic comes later.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "easeo/cms-core": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Easeo\\Shop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Easeo\\Shop\\Tests\\": "tests/"
        }
    },
    "extra": {
        "easeo": {
            "module-class": "Easeo\\Shop\\Module"
        }
    },
    "config": {
        "sort-packages": true
    }
}
